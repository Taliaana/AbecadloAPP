# Server only. Never prefix these with VITE_.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
TEACHER_PIN_HASH=
# Optional; defaults to pinktower-assets
SUPABASE_STORAGE_BUCKET=pinktower-assets
# A separate random secret protects daily cleanup of expired upload grants.
CRON_SECRET=
# Optional canonical HTTPS origin; omit to use the incoming deployment hostname.
APP_ORIGIN=
